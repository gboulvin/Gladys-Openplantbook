          "label": {
            "en": "Max temperature",
            "fr": "Température max",
            "de": "Max. Temperatur",
            "es": "Temperatura máx."
          }
        },
        {
          "key": "min_light_lux",
          "type": "number",
          "label": {
            "en": "Min light (lux)",
            "fr": "Lumière min (lux)",
            "de": "Min. Licht (Lux)",
            "es": "Luz mín. (lux)"
          }
        },
        {
          "key": "max_light_lux",
          "type": "number",
          "label": {
